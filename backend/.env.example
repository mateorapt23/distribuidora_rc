# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user_dist:user12345@localhost:5432/distribuidora_rc

# ── Autenticación JWT ─────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga
JWT_EXPIRES_IN=8h

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Email (recuperación de contraseña) ────────────────────────────────────────
